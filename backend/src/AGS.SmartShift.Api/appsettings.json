{
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "LoginRateLimit": {
      "MaxAttempts": 30,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "ags-smartshift",
    "Audience": "ags-smartshift-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Monitoring": {
    "GpsJitterIntervalSeconds": 30,
    "GpsJitterDegrees": 0.00022,
    "SignalRBroadcastIntervalSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
